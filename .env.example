# Required by the local Telegram Bot API service.
TELEGRAM_API_ID=replace-with-api-id-from-my-telegram-org
TELEGRAM_API_HASH=replace-with-api-hash-from-my-telegram-org

# Required by the watermark bot.
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token

# Local image tag used by ./startup.sh build/start.
WATERMARKER_IMAGE=tg-watermarker:latest

# macOS Apple-container bind-mounted data directory (relative to this repo or absolute).
# Linux/Docker Compose continues to use its named volume instead.
TELEGRAM_API_DATA_DIR=.container-data/telegram-bot-api

# Bot asset/configuration defaults.
SIGNATURE_IMAGE_DIR=/app/assets
SIGNATURE_IMAGE_FILE=signature.png
JPEG_QUALITY=95
MAX_FILE_SIZE_MB=100
FILE_TRANSFER_TIMEOUT_SECONDS=300
TELEGRAM_API_VERBOSITY=1
LOG_LEVEL=INFO
